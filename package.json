{
  "name": "krplot",
  "displayName": "krplot: R Plots pane",
  "description": "An RStudio/Positron-like Plots pane for R in VS Code, powered by httpgd: plot history, aspect ratio control, SVG/PNG export, separate window.",
  "version": "0.4.1",
  "publisher": "kbosirany",
  "author": {
    "name": "Kevin Bosirany Orlando"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b4a80",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kbosirany/krplot.vscode.git"
  },
  "bugs": {
    "url": "https://github.com/kbosirany/krplot.vscode/issues"
  },
  "homepage": "https://github.com/kbosirany/krplot.vscode#readme",
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "R",
    "plot",
    "plots",
    "httpgd",
    "graphics",
    "RStudio",
    "Positron",
    "ggplot2"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "krplot",
          "title": "R Plots",
          "icon": "media/plot.svg"
        }
      ]
    },
    "views": {
      "krplot": [
        {
          "type": "webview",
          "id": "krplot.plots",
          "name": "R Plots"
        }
      ]
    },
    "commands": [
      {
        "command": "krplot.openWindow",
        "title": "Open in Separate Window",
        "category": "R Plots",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "krplot.openBrowser",
        "title": "Open in Browser",
        "category": "R Plots",
        "icon": "$(link-external)"
      },
      {
        "command": "krplot.reload",
        "title": "Reload",
        "category": "R Plots",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "krplot.openWindow",
          "when": "view == krplot.plots",
          "group": "navigation@1"
        },
        {
          "command": "krplot.openBrowser",
          "when": "view == krplot.plots",
          "group": "navigation@2"
        },
        {
          "command": "krplot.reload",
          "when": "view == krplot.plots",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "krplot",
      "properties": {
        "krplot.revealOnNewSession": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the R Plots view when an R session opens its first plot."
        },
        "krplot.pollInterval": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "description": "Interval (ms) between checks of the R session for new plots."
        }
      }
    }
  }
}
