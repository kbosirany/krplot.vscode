{
  "name": "krplot",
  "displayName": "krplot: R Plots",
  "description": "Dedicated R plots view (httpgd) outside the editor area",
  "version": "0.3.0",
  "publisher": "korlando",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "panel": [
        { "id": "krplot", "title": "R Plots", "icon": "media/plot.svg" }
      ]
    },
    "views": {
      "krplot": [
        { "type": "webview", "id": "krplot.plots", "name": "R Plots" }
      ]
    },
    "commands": [
      {
        "command": "krplot.openWindow",
        "title": "R Plots: Open in Separate Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "krplot.openBrowser",
        "title": "R Plots: Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "krplot.reload",
        "title": "R Plots: Reload",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "krplot.openWindow",
          "when": "view == krplot.plots",
          "group": "navigation@1"
        },
        {
          "command": "krplot.openBrowser",
          "when": "view == krplot.plots",
          "group": "navigation@2"
        },
        {
          "command": "krplot.reload",
          "when": "view == krplot.plots",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "krplot",
      "properties": {
        "krplot.revealOnNewSession": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the R Plots view when an R session opens its first plot."
        },
        "krplot.pollInterval": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "description": "Interval (ms) between checks of the R session for new plots."
        }
      }
    }
  }
}
